{
  "name": "dsh-backup-ui",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && node -e \"const fs=require('fs');for(const p of ['dist/assets','dist/index.html'])fs.rmSync(p,{recursive:true,force:true})\" && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@babel/types": "^7.26.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.0"
  },
  "description": "DSH Backup desktop UI (Vue 3 + TypeScript)"
}
